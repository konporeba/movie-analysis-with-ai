	/// KPI card: genre with the highest revenue per film (30+ films), multiple of the average, revenue per film and median ROI.
	measure 'KPI Top Earner Genre HTML' = ```
			
						VAR _t = TOPN(1, FILTER(VALUES(Genres[Genre]), [Movies] >= 30), [Avg Revenue per Film], DESC)
						VAR _g = MAXX(_t, Genres[Genre])
						VAR _mult = DIVIDE(CALCULATE([Avg Revenue per Film], KEEPFILTERS(Genres[Genre] = _g)), CALCULATE([Avg Revenue per Film], REMOVEFILTERS(Genres), REMOVEFILTERS(MovieGenres)), 0)
						VAR __value = COALESCE(_g, "-")
						VAR __hi = FORMAT(_mult, "0.0", "en-US") & "x"
						VAR __hicol = "#3B82F6"
						VAR __text = "the average revenue per film"
						VAR __f0 = (VAR __m = COALESCE(CALCULATE([Avg Revenue per Film], KEEPFILTERS(Genres[Genre] = _g)), 0) RETURN IF(__m >= 1000000000, "$" & FORMAT(__m / 1000000000, "#,##0.0", "en-US") & "bn", IF(__m >= 1000000, "$" & FORMAT(__m / 1000000, "#,##0.0", "en-US") & "M", "$" & FORMAT(__m / 1000, "#,##0", "en-US") & "K")))
						VAR __f1 = FORMAT(COALESCE(CALCULATE([Median ROI], KEEPFILTERS(Genres[Genre] = _g)), 0), "0.0", "en-US") & "x"
						RETURN
						"<div style='box-sizing:border-box;height:100vh;width:100%;padding:26px 18px 16px 26px;border-radius:12px;background:linear-gradient(150deg,rgba(59,130,246,.13) 0%,rgba(11,23,48,0) 55%);font-family:Segoe UI,sans-serif;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start'>" &
						"<div style='position:absolute;left:0;top:18%;height:64%;width:4px;border-radius:0 4px 4px 0;background:#3B82F6;box-shadow:0 0 12px #3B82F6'></div>" &
						"<div style='font-size:12px;letter-spacing:2px;color:#9DB4D8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>TOP EARNING GENRE</div>" &
						"<div style='margin-top:4px;font-size:48px;line-height:1.08;font-weight:700;color:#EAF2FF;font-family:Bahnschrift,Segoe UI,sans-serif;text-shadow:0 0 16px rgba(59,130,246,.45);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & __value & "</div>" &
						"<div style='margin-top:8px;font-size:15px;line-height:1.35;color:#C9D7EE;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'><span style='color:" & __hicol & ";font-weight:700'>" & __hi & "</span> " & __text & "</div>" &
						"<div style='margin-top:12px;padding-top:10px;border-top:1px solid rgba(157,180,216,.16);display:flex;flex-wrap:wrap;column-gap:18px;row-gap:2px;font-size:13px'>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>Per film</span> <span style='color:#EAF2FF;font-weight:600'>" & __f0 & "</span></span>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>Median ROI</span> <span style='color:#EAF2FF;font-weight:600'>" & __f1 & "</span></span>" &
						"</div>" &
						"</div>"
			```
		displayFolder: KPI HTML
		lineageTag: dbc0b785-7eb2-46d9-a913-d5ca5401d1a8

	/// KPI card: best rated decade (100+ films), its lead over all films, score and film count.
	measure 'KPI Best Decade HTML' = ```
			
						VAR _t = TOPN(1, FILTER(VALUES(Movies[Decade]), [Movies] >= 100), [Weighted Rating], DESC)
						VAR _dname = MAXX(_t, Movies[Decade])
						VAR _r = MAXX(_t, [Weighted Rating])
						VAR _d = COALESCE(_r - [All Films Rating], 0)
						VAR __value = COALESCE(_dname, "-")
						VAR __hi = IF(_d >= 0, "&#9650; ", "&#9660; ") & IF(_d >= 0, "+", "") & FORMAT(_d, "0.00", "en-US")
						VAR __hicol = IF(_d >= 0, "#34D399", "#FB923C")
						VAR __text = "rating points above all films"
						VAR __f0 = FORMAT(COALESCE(_r, 0), "0.00", "en-US")
						VAR __f1 = FORMAT(COALESCE(CALCULATE([Movies], Movies[Decade] = _dname), 0), "#,##0", "en-US")
						RETURN
						"<div style='box-sizing:border-box;height:100vh;width:100%;padding:26px 18px 16px 26px;border-radius:12px;background:linear-gradient(150deg,rgba(45,212,191,.13) 0%,rgba(11,23,48,0) 55%);font-family:Segoe UI,sans-serif;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start'>" &
						"<div style='position:absolute;left:0;top:18%;height:64%;width:4px;border-radius:0 4px 4px 0;background:#2DD4BF;box-shadow:0 0 12px #2DD4BF'></div>" &
						"<div style='font-size:12px;letter-spacing:2px;color:#9DB4D8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>BEST RATED DECADE</div>" &
						"<div style='margin-top:4px;font-size:48px;line-height:1.08;font-weight:700;color:#EAF2FF;font-family:Bahnschrift,Segoe UI,sans-serif;text-shadow:0 0 16px rgba(45,212,191,.45);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & __value & "</div>" &
						"<div style='margin-top:8px;font-size:15px;line-height:1.35;color:#C9D7EE;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'><span style='color:" & __hicol & ";font-weight:700'>" & __hi & "</span> " & __text & "</div>" &
						"<div style='margin-top:12px;padding-top:10px;border-top:1px solid rgba(157,180,216,.16);display:flex;flex-wrap:wrap;column-gap:18px;row-gap:2px;font-size:13px'>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>Score</span> <span style='color:#EAF2FF;font-weight:600'>" & __f0 & "</span></span>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>Films</span> <span style='color:#EAF2FF;font-weight:600'>" & __f1 & "</span></span>" &
						"</div>" &
						"</div>"
			```
		displayFolder: KPI HTML
		lineageTag: 12652a9b-5521-4996-8e79-9e0be792e6c5

	/// KPI card: highest-grossing film, its revenue and ROI, and its share of the selection revenue.
	measure 'KPI Top Grossing HTML' = ```
			
						VAR _t = TOPN(1, VALUES(Movies[Title and Year]), [Total Revenue], DESC)
						VAR _f = MAXX(_t, Movies[Title and Year])
						VAR __value = SUBSTITUTE(SUBSTITUTE(COALESCE(_f, "-"), "&", "&amp;"), "<", "&lt;")
						VAR __hi = (VAR __m = COALESCE(CALCULATE([Total Revenue], Movies[Title and Year] = _f), 0) RETURN IF(__m >= 1000000000, "$" & FORMAT(__m / 1000000000, "#,##0.0", "en-US") & "bn", IF(__m >= 1000000, "$" & FORMAT(__m / 1000000, "#,##0.0", "en-US") & "M", "$" & FORMAT(__m / 1000, "#,##0", "en-US") & "K")))
						VAR __hicol = "#3B82F6"
						VAR __text = "worldwide revenue"
						VAR __f0 = FORMAT(COALESCE(CALCULATE([ROI], Movies[Title and Year] = _f), 0), "0.0", "en-US") & "x budget"
						VAR __f1 = FORMAT(COALESCE(DIVIDE(CALCULATE([Total Revenue], Movies[Title and Year] = _f), [Total Revenue]), 0), "0.0%", "en-US")
						RETURN
						"<div style='box-sizing:border-box;height:100vh;width:100%;padding:26px 18px 16px 26px;border-radius:12px;background:linear-gradient(150deg,rgba(59,130,246,.13) 0%,rgba(11,23,48,0) 55%);font-family:Segoe UI,sans-serif;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start'>" &
						"<div style='position:absolute;left:0;top:18%;height:64%;width:4px;border-radius:0 4px 4px 0;background:#3B82F6;box-shadow:0 0 12px #3B82F6'></div>" &
						"<div style='font-size:12px;letter-spacing:2px;color:#9DB4D8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>HIGHEST GROSSING FILM</div>" &
						"<div style='margin-top:4px;font-size:30px;line-height:1.08;font-weight:700;color:#EAF2FF;font-family:Bahnschrift,Segoe UI,sans-serif;text-shadow:0 0 16px rgba(59,130,246,.45);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & __value & "</div>" &
						"<div style='margin-top:8px;font-size:15px;line-height:1.35;color:#C9D7EE;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'><span style='color:" & __hicol & ";font-weight:700'>" & __hi & "</span> " & __text & "</div>" &
						"<div style='margin-top:12px;padding-top:10px;border-top:1px solid rgba(157,180,216,.16);display:flex;flex-wrap:wrap;column-gap:18px;row-gap:2px;font-size:13px'>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>ROI</span> <span style='color:#EAF2FF;font-weight:600'>" & __f0 & "</span></span>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>Share</span> <span style='color:#EAF2FF;font-weight:600'>" & __f1 & "</span></span>" &
						"</div>" &
						"</div>"
			```
		displayFolder: KPI HTML
		lineageTag: 65ab4003-d9b4-4732-a549-90700ecacd27

	/// KPI card: highest weighted-rating film, its score, votes and lead over all films.
	measure 'KPI Top Rated HTML' = ```
			
						VAR _t = TOPN(1, VALUES(Movies[Title and Year]), [Weighted Rating], DESC)
						VAR _f = MAXX(_t, Movies[Title and Year])
						VAR __value = SUBSTITUTE(SUBSTITUTE(COALESCE(_f, "-"), "&", "&amp;"), "<", "&lt;")
						VAR __hi = FORMAT(COALESCE(CALCULATE([Weighted Rating], Movies[Title and Year] = _f), 0), "0.00", "en-US")
						VAR __hicol = "#A78BFA"
						VAR __text = "vote-weighted score out of 10"
						VAR __f0 = FORMAT(COALESCE(CALCULATE([Total Votes], Movies[Title and Year] = _f), 0), "#,##0", "en-US")
						VAR __f1 = IF(COALESCE(CALCULATE([Rating vs All Films], Movies[Title and Year] = _f), 0) >= 0, "+", "") & FORMAT(COALESCE(CALCULATE([Rating vs All Films], Movies[Title and Year] = _f), 0), "0.00", "en-US")
						RETURN
						"<div style='box-sizing:border-box;height:100vh;width:100%;padding:26px 18px 16px 26px;border-radius:12px;background:linear-gradient(150deg,rgba(167,139,250,.13) 0%,rgba(11,23,48,0) 55%);font-family:Segoe UI,sans-serif;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start'>" &
						"<div style='position:absolute;left:0;top:18%;height:64%;width:4px;border-radius:0 4px 4px 0;background:#A78BFA;box-shadow:0 0 12px #A78BFA'></div>" &
						"<div style='font-size:12px;letter-spacing:2px;color:#9DB4D8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>HIGHEST RATED FILM</div>" &
						"<div style='margin-top:4px;font-size:30px;line-height:1.08;font-weight:700;color:#EAF2FF;font-family:Bahnschrift,Segoe UI,sans-serif;text-shadow:0 0 16px rgba(167,139,250,.45);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & __value & "</div>" &
						"<div style='margin-top:8px;font-size:15px;line-height:1.35;color:#C9D7EE;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'><span style='color:" & __hicol & ";font-weight:700'>" & __hi & "</span> " & __text & "</div>" &
						"<div style='margin-top:12px;padding-top:10px;border-top:1px solid rgba(157,180,216,.16);display:flex;flex-wrap:wrap;column-gap:18px;row-gap:2px;font-size:13px'>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>Votes</span> <span style='color:#EAF2FF;font-weight:600'>" & __f0 & "</span></span>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>vs all films</span> <span style='color:#EAF2FF;font-weight:600'>" & __f1 & "</span></span>" &
						"</div>" &
						"</div>"
			```
		displayFolder: KPI HTML
		lineageTag: ac359325-4084-4d2d-90c1-d02f26ab6636

	/// KPI card: most-voted film, its votes, rating and share of all votes.
	measure 'KPI Most Voted HTML' = ```
			
						VAR _t = TOPN(1, VALUES(Movies[Title and Year]), [Total Votes], DESC)
						VAR _f = MAXX(_t, Movies[Title and Year])
						VAR __value = SUBSTITUTE(SUBSTITUTE(COALESCE(_f, "-"), "&", "&amp;"), "<", "&lt;")
						VAR __hi = FORMAT(COALESCE(CALCULATE([Total Votes], Movies[Title and Year] = _f), 0), "#,##0", "en-US")
						VAR __hicol = "#22D3EE"
						VAR __text = "votes on TMDB"
						VAR __f0 = FORMAT(COALESCE(CALCULATE([Weighted Rating], Movies[Title and Year] = _f), 0), "0.00", "en-US")
						VAR __f1 = FORMAT(COALESCE(DIVIDE(CALCULATE([Total Votes], Movies[Title and Year] = _f), [Total Votes]), 0), "0.0%", "en-US")
						RETURN
						"<div style='box-sizing:border-box;height:100vh;width:100%;padding:26px 18px 16px 26px;border-radius:12px;background:linear-gradient(150deg,rgba(34,211,238,.13) 0%,rgba(11,23,48,0) 55%);font-family:Segoe UI,sans-serif;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start'>" &
						"<div style='position:absolute;left:0;top:18%;height:64%;width:4px;border-radius:0 4px 4px 0;background:#22D3EE;box-shadow:0 0 12px #22D3EE'></div>" &
						"<div style='font-size:12px;letter-spacing:2px;color:#9DB4D8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>MOST VOTED FILM</div>" &
						"<div style='margin-top:4px;font-size:30px;line-height:1.08;font-weight:700;color:#EAF2FF;font-family:Bahnschrift,Segoe UI,sans-serif;text-shadow:0 0 16px rgba(34,211,238,.45);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & __value & "</div>" &
						"<div style='margin-top:8px;font-size:15px;line-height:1.35;color:#C9D7EE;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'><span style='color:" & __hicol & ";font-weight:700'>" & __hi & "</span> " & __text & "</div>" &
						"<div style='margin-top:12px;padding-top:10px;border-top:1px solid rgba(157,180,216,.16);display:flex;flex-wrap:wrap;column-gap:18px;row-gap:2px;font-size:13px'>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>Rating</span> <span style='color:#EAF2FF;font-weight:600'>" & __f0 & "</span></span>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>Share of votes</span> <span style='color:#EAF2FF;font-weight:600'>" & __f1 & "</span></span>" &
						"</div>" &
						"</div>"
			```
		displayFolder: KPI HTML
		lineageTag: 3b6c7ffd-0cc6-4dc7-bc24-178c6be2b96f

	/// KPI card: film count, share with a reliable rating (10+ votes), average votes and franchise share.
	measure 'KPI Films Shown HTML' = ```
			
						VAR __value = FORMAT(COALESCE([Movies], 0), "#,##0", "en-US")
						VAR __hi = FORMAT(COALESCE(DIVIDE([Rated Movies], [Movies]), 0), "0%", "en-US")
						VAR __hicol = "#4ADE80"
						VAR __text = "have 10+ votes and a reliable rating"
						VAR __f0 = FORMAT(COALESCE([Avg Votes per Film], 0), "#,##0", "en-US")
						VAR __f1 = FORMAT(COALESCE([Franchise Film Share], 0), "0.0%", "en-US")
						RETURN
						"<div style='box-sizing:border-box;height:100vh;width:100%;padding:26px 18px 16px 26px;border-radius:12px;background:linear-gradient(150deg,rgba(74,222,128,.13) 0%,rgba(11,23,48,0) 55%);font-family:Segoe UI,sans-serif;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start'>" &
						"<div style='position:absolute;left:0;top:18%;height:64%;width:4px;border-radius:0 4px 4px 0;background:#4ADE80;box-shadow:0 0 12px #4ADE80'></div>" &
						"<div style='font-size:12px;letter-spacing:2px;color:#9DB4D8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>FILMS IN SELECTION</div>" &
						"<div style='margin-top:4px;font-size:48px;line-height:1.08;font-weight:700;color:#EAF2FF;font-family:Bahnschrift,Segoe UI,sans-serif;text-shadow:0 0 16px rgba(74,222,128,.45);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & __value & "</div>" &
						"<div style='margin-top:8px;font-size:15px;line-height:1.35;color:#C9D7EE;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'><span style='color:" & __hicol & ";font-weight:700'>" & __hi & "</span> " & __text & "</div>" &
						"<div style='margin-top:12px;padding-top:10px;border-top:1px solid rgba(157,180,216,.16);display:flex;flex-wrap:wrap;column-gap:18px;row-gap:2px;font-size:13px'>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>Avg votes</span> <span style='color:#EAF2FF;font-weight:600'>" & __f0 & "</span></span>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>Franchise films</span> <span style='color:#EAF2FF;font-weight:600'>" & __f1 & "</span></span>" &
						"</div>" &
						"</div>"
			```
		displayFolder: KPI HTML
		lineageTag: a81e268f-033f-430b-82af-0889b2c867dc

	/// Median budget of films with a known budget; not skewed by blockbusters like the average.
	measure 'Median Budget' = MEDIAN(Movies[Budget])
		formatString: $#,0
		displayFolder: Financials
		lineageTag: a4503556-fee1-4c48-b40f-12f0a8cbdca2

	/// Median worldwide revenue of films with a known revenue.
	measure 'Median Revenue' = MEDIAN(Movies[Revenue])
		formatString: $#,0
		displayFolder: Financials
		lineageTag: a360d639-c1bc-478d-a3dd-9a705ab3373a

	/// Average budget of films with a known budget.
	measure 'Avg Budget per Film' = AVERAGE(Movies[Budget])
		formatString: $#,0
		displayFolder: Financials
		lineageTag: 1f30133a-6bd8-4442-8a32-74e81f23c181

	/// Total profit as a share of revenue, for films with both budget and revenue known.
	measure 'Profit Margin' = DIVIDE([Total Profit], CALCULATE(SUM(Movies[Revenue]), Movies[Has Financials] = "Yes"))
		formatString: 0%
		displayFolder: Financials
		lineageTag: 0a380375-48a8-4c33-9c4b-59932031bec0

	/// Number of films that grossed $100M or more.
	measure Blockbusters = CALCULATE(COUNTROWS(Movies), Movies[Revenue] >= 100000000)
		formatString: #,0
		displayFolder: Financials
		lineageTag: a5caadea-b09d-4b89-9481-9b20e8a901a7

	/// Share of films with a known revenue that grossed $100M or more.
	measure 'Blockbuster Rate' = DIVIDE([Blockbusters], CALCULATE(COUNTROWS(Movies), NOT ISBLANK(Movies[Revenue])))
		formatString: 0.0%
		displayFolder: Financials
		lineageTag: 44636e55-7cc8-4ed8-b273-df7ffe4837c6

	/// Number of films with a budget of $100M or more.
	measure 'Big Budget Films' = CALCULATE(COUNTROWS(Movies), Movies[Budget] >= 100000000)
		formatString: #,0
		displayFolder: Financials
		lineageTag: ddb4a696-b81b-4b6c-a0cc-e360a5826037

	/// Share of revenue earned by films that belong to a collection (franchise).
	measure 'Franchise Revenue Share' = DIVIDE(CALCULATE([Total Revenue], Movies[Collection Name] <> ""), [Total Revenue])
		formatString: 0%
		displayFolder: Financials
		lineageTag: 7b92c3e9-7ead-4c68-9d5f-0efaa38a674a

	/// Share of films that belong to a collection (franchise).
	measure 'Franchise Film Share' = DIVIDE(CALCULATE([Movies], Movies[Collection Name] <> ""), [Movies])
		formatString: 0%
		displayFolder: Counts
		lineageTag: c4610d8d-ec40-49f9-a363-7b6a04245bf1

	/// Share of revenue earned by the ten highest-grossing films of the selection (concentration).
	measure 'Top 10 Revenue Share' = DIVIDE(SUMX(TOPN(10, VALUES(Movies[Movie ID]), CALCULATE(SUM(Movies[Revenue]))), CALCULATE(SUM(Movies[Revenue]))), [Total Revenue])
		formatString: 0.0%
		displayFolder: Financials
		lineageTag: 7c24fe92-5af8-40d6-a0aa-86fae680803b

	/// Average number of films per release year in the selection.
	measure 'Films per Year' = DIVIDE([Movies], DISTINCTCOUNT(Movies[Release Year]))
		formatString: #,0
		displayFolder: Counts
		lineageTag: 49695833-e08c-44ef-9e77-95e9eaf42c3e

	/// Release year with the most films in the selection.
	measure 'Peak Year' = MAXX(TOPN(1, VALUES(Movies[Release Year]), [Movies], DESC, Movies[Release Year], DESC), Movies[Release Year])
		formatString: 0
		displayFolder: Counts
		lineageTag: 345a02f4-41f8-4dc8-8c5f-eea1e7b9fe50

	/// Films released in the peak year.
	measure 'Peak Year Films' = VAR _y = [Peak Year] RETURN CALCULATE([Movies], Movies[Release Year] = _y)
		formatString: #,0
		displayFolder: Counts
		lineageTag: 5e860679-dff0-40e1-b63e-5a38ab5831a9

	/// Films per year in 2010-2016 divided by films per year in the 1980s (2017 is partial and left out).
	measure 'Output Growth vs 1980s' = DIVIDE(CALCULATE([Movies], REMOVEFILTERS(Movies[Decade]), Movies[Release Year] >= 2010, Movies[Release Year] <= 2016) / 7, CALCULATE([Movies], REMOVEFILTERS(Movies[Decade]), Movies[Decade] = "1980s") / 10)
		formatString: 0.0"x"
		displayFolder: Counts
		lineageTag: 7ba90aaa-36d0-4f9a-a192-41720597fb34

	/// Weighted rating of the 2010s minus the 1980s; negative means ratings slipped.
	measure 'Rating Change vs 1980s' = CALCULATE([Weighted Rating], REMOVEFILTERS(Movies[Decade]), Movies[Decade] = "2010s") - CALCULATE([Weighted Rating], REMOVEFILTERS(Movies[Decade]), Movies[Decade] = "1980s")
		formatString: +0.00;-0.00;0.00
		displayFolder: Ratings
		lineageTag: 3374d7a0-723c-40be-9437-3af8dfc99f1a

	/// Median runtime in minutes.
	measure 'Median Runtime' = MEDIAN(Movies[Runtime])
		formatString: 0
		displayFolder: Runtime
		lineageTag: 82dc85d2-6782-4318-b56a-840bda3235c3

	/// Share of films with a known runtime longer than 120 minutes.
	measure '% Over 2 Hours' = DIVIDE(CALCULATE(COUNTROWS(Movies), Movies[Runtime] > 120), CALCULATE(COUNTROWS(Movies), NOT ISBLANK(Movies[Runtime])))
		formatString: 0%
		displayFolder: Runtime
		lineageTag: b9ea14f3-4aea-4d94-beba-07e0ec0691dc

	/// Average number of TMDB votes per film.
	measure 'Avg Votes per Film' = DIVIDE([Total Votes], [Movies])
		formatString: #,0
		displayFolder: Ratings
		lineageTag: 34e723a5-6270-4806-9c72-f00e279ae685

	/// Films of the genre as a share of all films in the selection (a film can have several genres).
	measure 'Genre Share' = DIVIDE([Movies], CALCULATE([Movies], REMOVEFILTERS(Genres), REMOVEFILTERS(MovieGenres)))
		formatString: 0.0%
		displayFolder: Counts
		lineageTag: e230f4b9-c76e-4b5a-8bcd-90e6c7f02c6b

	/// Five-year trailing average of films released per year (use with Release Year on the axis).
	measure 'Films 5y Avg' = VAR _y = MAX(Movies[Release Year]) RETURN IF(ISINSCOPE(Movies[Release Year]), DIVIDE(CALCULATE([Movies], REMOVEFILTERS(Movies[Release Year]), Movies[Release Year] > _y - 5, Movies[Release Year] <= _y), 5))
		formatString: #,0
		displayFolder: Counts
		lineageTag: 0989cb69-d6e7-4ac8-9923-9314e800e1ab

	/// Films in the language as a share of all films in the selection.
	measure 'Language Share' = DIVIDE([Movies], CALCULATE([Movies], REMOVEFILTERS(Movies[Language])))
		formatString: 0.0%
		displayFolder: Counts
		lineageTag: 01eb052c-79ec-4416-9954-c4a617978342

	/// Films from the primary production country as a share of all films in the selection.
	measure 'Country Share' = DIVIDE([Movies], CALCULATE([Movies], REMOVEFILTERS(Movies[Primary Country])))
		formatString: 0.0%
		displayFolder: Counts
		lineageTag: 926d347c-d156-4511-92d0-dceb706087f6

	/// Median ROI of the selection ignoring the genre on the axis; the reference line for genre ROI charts.
	measure 'Median ROI All Genres' = CALCULATE([Median ROI], REMOVEFILTERS(Genres), REMOVEFILTERS(MovieGenres))
		formatString: 0.0"x"
		displayFolder: Reference
		lineageTag: 28e50d04-1a1c-4930-bb6f-dee4b3e33bcf

	/// Total profit in millions of USD, for axes.
	measure 'Profit (USD M)' = DIVIDE([Total Profit], 1000000)
		formatString: $#,0.#"M"
		displayFolder: Financials
		lineageTag: a8330068-0e1a-475b-bc82-328a3fc29deb

	/// Header chips listing the fields filtered by slicers (Decade, Genre, Language, Budget tier) and the number of films shown.
	measure 'Filter Summary HTML' = ```
			
						VAR _nDecade = COUNTROWS(VALUES(Movies[Decade]))
						VAR _vDecade = IF(ISFILTERED(Movies[Decade]),
							"<span style='display:inline-block;margin-left:8px;padding:5px 12px;border-radius:14px;background:rgba(34,211,238,.10);border:1px solid rgba(34,211,238,.4);white-space:nowrap'><span style='color:#7DE3F4'>Decade</span> " &
							SUBSTITUTE(SUBSTITUTE(IF(_nDecade <= 2, CONCATENATEX(VALUES(Movies[Decade]), Movies[Decade], ", ", CALCULATE(MIN(Movies[Decade Sort])), ASC), CONCATENATEX(TOPN(2, VALUES(Movies[Decade]), CALCULATE(MIN(Movies[Decade Sort])), ASC), Movies[Decade], ", ", CALCULATE(MIN(Movies[Decade Sort])), ASC) & " +" & (_nDecade - 2)), "&", "&amp;"), "<", "&lt;") & "</span>")
						VAR _nGenre = COUNTROWS(VALUES(Genres[Genre]))
						VAR _vGenre = IF(ISFILTERED(Genres[Genre]),
							"<span style='display:inline-block;margin-left:8px;padding:5px 12px;border-radius:14px;background:rgba(34,211,238,.10);border:1px solid rgba(34,211,238,.4);white-space:nowrap'><span style='color:#7DE3F4'>Genre</span> " &
							SUBSTITUTE(SUBSTITUTE(IF(_nGenre <= 2, CONCATENATEX(VALUES(Genres[Genre]), Genres[Genre], ", ", Genres[Genre], ASC), CONCATENATEX(TOPN(2, VALUES(Genres[Genre]), Genres[Genre], ASC), Genres[Genre], ", ", Genres[Genre], ASC) & " +" & (_nGenre - 2)), "&", "&amp;"), "<", "&lt;") & "</span>")
						VAR _nLanguage = COUNTROWS(VALUES(Movies[Language]))
						VAR _vLanguage = IF(ISFILTERED(Movies[Language]),
							"<span style='display:inline-block;margin-left:8px;padding:5px 12px;border-radius:14px;background:rgba(34,211,238,.10);border:1px solid rgba(34,211,238,.4);white-space:nowrap'><span style='color:#7DE3F4'>Language</span> " &
							SUBSTITUTE(SUBSTITUTE(IF(_nLanguage <= 2, CONCATENATEX(VALUES(Movies[Language]), Movies[Language], ", ", Movies[Language], ASC), CONCATENATEX(TOPN(2, VALUES(Movies[Language]), Movies[Language], ASC), Movies[Language], ", ", Movies[Language], ASC) & " +" & (_nLanguage - 2)), "&", "&amp;"), "<", "&lt;") & "</span>")
						VAR _nTier = COUNTROWS(VALUES(Movies[Budget Tier]))
						VAR _vTier = IF(ISFILTERED(Movies[Budget Tier]),
							"<span style='display:inline-block;margin-left:8px;padding:5px 12px;border-radius:14px;background:rgba(34,211,238,.10);border:1px solid rgba(34,211,238,.4);white-space:nowrap'><span style='color:#7DE3F4'>Tier</span> " &
							SUBSTITUTE(SUBSTITUTE(IF(_nTier <= 2, CONCATENATEX(VALUES(Movies[Budget Tier]), Movies[Budget Tier], ", ", CALCULATE(MIN(Movies[Budget Tier Sort])), ASC), CONCATENATEX(TOPN(2, VALUES(Movies[Budget Tier]), CALCULATE(MIN(Movies[Budget Tier Sort])), ASC), Movies[Budget Tier], ", ", CALCULATE(MIN(Movies[Budget Tier Sort])), ASC) & " +" & (_nTier - 2)), "&", "&amp;"), "<", "&lt;") & "</span>")
						VAR _chips = _vDecade & _vGenre & _vLanguage & _vTier
						VAR _films = FORMAT(COALESCE([Movies], 0), "#,##0", "en-US")
						RETURN
						"<div style='box-sizing:border-box;height:100vh;width:100%;display:flex;align-items:center;justify-content:flex-end;font-family:Segoe UI,sans-serif;font-size:13px;color:#EAF2FF;overflow:hidden'>" &
						IF(_chips = "", "<span style='color:#7F97BD'>No filters applied</span>", "<span style='color:#7F97BD'>Filtered by</span>" & _chips) &
						"<span style='margin-left:14px;color:#7F97BD;white-space:nowrap'><span style='color:#EAF2FF;font-weight:600'>" & _films & "</span> films</span>" &
						"</div>"
			```
		displayFolder: KPI HTML
		lineageTag: 24da9067-8ca9-44cf-84ba-b87a8de4a5ae

	column Placeholder
		dataType: int64
		isHidden
		lineageTag: 6eb00c6b-109f-4019-8166-492665dcc44e
		summarizeBy: none
		sourceColumn: Placeholder

