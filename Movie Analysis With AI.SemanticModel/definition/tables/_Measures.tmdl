	/// KPI card: largest genre (30+ films), its share of films, film count and rating vs all films.
	measure 'KPI Most Films Genre HTML' = ```
			
						VAR _t = TOPN(1, FILTER(VALUES(Genres[Genre]), [Movies] >= 30), [Movies], DESC)
						VAR _g = MAXX(_t, Genres[Genre])
						VAR __value = COALESCE(_g, "-")
						VAR __hi = FORMAT(COALESCE(CALCULATE([Genre Share], KEEPFILTERS(Genres[Genre] = _g)), 0), "0%", "en-US")
						VAR __hicol = "#22D3EE"
						VAR __text = "of all films carry this genre"
						VAR __f0 = FORMAT(COALESCE(CALCULATE([Movies], KEEPFILTERS(Genres[Genre] = _g)), 0), "#,##0", "en-US")
						VAR __f1 = IF(COALESCE(CALCULATE([Rating vs All Films], KEEPFILTERS(Genres[Genre] = _g)), 0) >= 0, "+", "") & FORMAT(COALESCE(CALCULATE([Rating vs All Films], KEEPFILTERS(Genres[Genre] = _g)), 0), "0.00", "en-US")
						RETURN
						"<div style='box-sizing:border-box;height:100vh;width:100%;padding:26px 18px 16px 26px;border-radius:12px;background:linear-gradient(150deg,rgba(34,211,238,.13) 0%,rgba(11,23,48,0) 55%);font-family:Segoe UI,sans-serif;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start'>" &
						"<div style='position:absolute;left:0;top:18%;height:64%;width:4px;border-radius:0 4px 4px 0;background:#22D3EE;box-shadow:0 0 12px #22D3EE'></div>" &
						"<div style='font-size:12px;letter-spacing:2px;color:#9DB4D8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>GENRE WITH MOST FILMS</div>" &
						"<div style='margin-top:4px;font-size:48px;line-height:1.08;font-weight:700;color:#EAF2FF;font-family:Bahnschrift,Segoe UI,sans-serif;text-shadow:0 0 16px rgba(34,211,238,.45);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & __value & "</div>" &
						"<div style='margin-top:8px;font-size:15px;line-height:1.35;color:#C9D7EE;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'><span style='color:" & __hicol & ";font-weight:700'>" & __hi & "</span> " & __text & "</div>" &
						"<div style='margin-top:12px;padding-top:10px;border-top:1px solid rgba(157,180,216,.16);display:flex;flex-wrap:wrap;column-gap:18px;row-gap:2px;font-size:13px'>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>Films</span> <span style='color:#EAF2FF;font-weight:600'>" & __f0 & "</span></span>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>Rating vs all</span> <span style='color:#EAF2FF;font-weight:600'>" & __f1 & "</span></span>" &
						"</div>" &
						"</div>"
			```
		displayFolder: KPI HTML
		lineageTag: 5d4b3746-044a-482e-ba73-6d3a20359fcd

	/// KPI card: best rated genre (30+ films), its lead over all films, score and share rated 7+.
	measure 'KPI Best Genre HTML' = ```
			
						VAR _t = TOPN(1, FILTER(VALUES(Genres[Genre]), [Movies] >= 30), [Weighted Rating], DESC)
						VAR _g = MAXX(_t, Genres[Genre])
						VAR _d = COALESCE(CALCULATE([Rating vs All Films], KEEPFILTERS(Genres[Genre] = _g)), 0)
						VAR __value = COALESCE(_g, "-")
						VAR __hi = IF(_d >= 0, "&#9650; ", "&#9660; ") & IF(_d >= 0, "+", "") & FORMAT(_d, "0.00", "en-US")
						VAR __hicol = IF(_d >= 0, "#34D399", "#FB923C")
						VAR __text = "rating points above all films"
						VAR __f0 = FORMAT(COALESCE(CALCULATE([Weighted Rating], KEEPFILTERS(Genres[Genre] = _g)), 0), "0.00", "en-US")
						VAR __f1 = FORMAT(COALESCE(CALCULATE([% Rated 7+], KEEPFILTERS(Genres[Genre] = _g)), 0), "0%", "en-US")
						RETURN
						"<div style='box-sizing:border-box;height:100vh;width:100%;padding:26px 18px 16px 26px;border-radius:12px;background:linear-gradient(150deg,rgba(167,139,250,.13) 0%,rgba(11,23,48,0) 55%);font-family:Segoe UI,sans-serif;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start'>" &
						"<div style='position:absolute;left:0;top:18%;height:64%;width:4px;border-radius:0 4px 4px 0;background:#A78BFA;box-shadow:0 0 12px #A78BFA'></div>" &
