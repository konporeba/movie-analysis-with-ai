/// Holds every measure in the model (no data). Measures are organised in display folders: Counts, Ratings, Financials, Runtime, Reference, Labels and Visuals, KPI HTML.
table _Measures
	lineageTag: fe578aa9-01ed-47ce-96c5-7b900061f8e3

	/// Number of movies in the current selection.
	measure Movies = COUNTROWS(Movies)
		formatString: #,##0
		displayFolder: Counts
		lineageTag: cf94c82b-13ad-44fd-a504-34b181cf5c9b

	/// Movies with at least 10 votes, the threshold used for average-rating measures.
	measure 'Rated Movies' = CALCULATE(COUNTROWS(Movies), Movies[Vote Count] >= 10)
		formatString: #,##0
		displayFolder: Counts
		lineageTag: 37fbf9db-c553-430f-a1cb-7ba959861dd3

	/// Movies where both budget and revenue are known (each at least $10,000). Basis for ROI and hit rate.
	measure 'Movies with Financials' = CALCULATE(COUNTROWS(Movies), Movies[Has Financials] = "Yes")
		formatString: #,##0
		displayFolder: Counts
		lineageTag: 2742a0be-c359-44aa-972a-06970270739c

	/// Selected movies as a share of every movie in the model, ignoring all filters.
	measure 'Share of All Films' = DIVIDE([Movies], CALCULATE(COUNTROWS(Movies), REMOVEFILTERS(Movies), REMOVEFILTERS(Genres), REMOVEFILTERS(MovieGenres)))
		formatString: 0.0%
		displayFolder: Counts
		lineageTag: aa13772e-11b7-44b8-9282-e2bd37d9cad9

	/// Sum of user votes across the selected movies.
	measure 'Total Votes' = SUM(Movies[Vote Count])
		formatString: #,##0
		displayFolder: Ratings
		lineageTag: abdae87c-444b-45ba-9ee7-c3a67b882713

	/// Simple average of vote average across movies with at least 10 votes (0-10 scale).
	measure 'Avg Rating' = CALCULATE(AVERAGE(Movies[Vote Average]), Movies[Vote Count] >= 10)
		formatString: 0.0
		displayFolder: Ratings
		lineageTag: 59bba68a-2105-4c29-b5c0-7ab2e4394da3

	/// Vote-weighted average rating of every movie in the model, ignoring filters. Prior mean for Weighted Rating.
	measure 'All Films Rating' = DIVIDE(CALCULATE(SUM(Movies[Vote Points]), REMOVEFILTERS(Movies), REMOVEFILTERS(Genres), REMOVEFILTERS(MovieGenres)), CALCULATE(SUM(Movies[Vote Count]), REMOVEFILTERS(Movies), REMOVEFILTERS(Genres), REMOVEFILTERS(MovieGenres)))
		formatString: 0.00
		displayFolder: Reference
		lineageTag: 4a087acf-6ea3-445f-90d1-4ba87f476730

	/// Vote-weighted rating shrunk toward the all-films mean with a prior of 100 votes (IMDb-style Bayesian average). Use it instead of Avg Rating to compare groups with very different vote counts.
	measure 'Weighted Rating' =
			VAR _votes = SUM(Movies[Vote Count])
			VAR _points = SUM(Movies[Vote Points])
			VAR _prior = 100
			RETURN IF(_votes = 0, BLANK(), DIVIDE(_points + _prior * [All Films Rating], _votes + _prior))
		formatString: 0.00
		displayFolder: Ratings
		lineageTag: 30ccdd89-456c-4d7b-8ea3-31303abff7d5

	/// Weighted Rating minus the all-films rating; positive means better rated than the whole catalogue.
	measure 'Rating vs All Films' = [Weighted Rating] - [All Films Rating]
		formatString: +0.00;-0.00;0.00
		displayFolder: Ratings
		lineageTag: 1a44b9f1-1dae-426f-ba84-4da0e2076de7

	/// Share of rated movies (10+ votes) with an average rating of 7 or higher.
	measure '% Rated 7+' = DIVIDE(CALCULATE(COUNTROWS(Movies), Movies[Vote Average] >= 7, Movies[Vote Count] >= 10), [Rated Movies])
		formatString: 0%
		displayFolder: Ratings
		lineageTag: fc6aca2e-28f4-4112-b1d7-e0172c5853e5

	/// Five-star text rendering of Weighted Rating (10-point scale halved).
	measure 'Rating Stars' =
			VAR _stars = ROUND(COALESCE([Weighted Rating], 0) / 2, 0)
			RETURN REPT(UNICHAR(9733), _stars) & REPT(UNICHAR(9734), 5 - _stars)
		displayFolder: Labels and Visuals
		lineageTag: 46256c70-baa6-419a-8e34-cbdfcbd70d45

	/// Inline SVG progress bar of Weighted Rating (0-10) for use in tables.
	measure 'Rating Bar SVG' =
			VAR _w = ROUND(COALESCE([Weighted Rating], 0) * 10, 0)
			RETURN "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='14'><rect width='100' height='14' rx='7' fill='%231F3A6B'/><rect width='" & _w & "' height='14' rx='7' fill='%2322D3EE'/></svg>"
		displayFolder: Labels and Visuals
		lineageTag: 0529a085-f0c3-4d7a-a897-42571be8f3e8
		dataCategory: ImageUrl

	/// Sum of worldwide revenue for movies with a known revenue (at least $10,000).
	measure 'Total Revenue' = SUM(Movies[Revenue])
		formatString: $#,0
		displayFolder: Financials
		lineageTag: 99e4ba5b-0719-4f96-bd2c-97ef00687bdb

	/// Sum of production budgets for movies with a known budget (at least $10,000).
	measure 'Total Budget' = SUM(Movies[Budget])
		formatString: $#,0
		displayFolder: Financials
		lineageTag: 3d5f81b6-edc8-4984-a4fe-581df7378e5e

	/// Revenue minus budget, for movies where both are known.
	measure 'Total Profit' = SUM(Movies[Profit])
		formatString: $#,0
		displayFolder: Financials
		lineageTag: ca737863-eaec-40d6-8a1c-74d2e573111b

	/// Average revenue across movies with a known revenue.
	measure 'Avg Revenue per Film' = AVERAGE(Movies[Revenue])
		formatString: $#,0
		displayFolder: Financials
		lineageTag: b23e765f-cf91-4d09-9bae-1841557c7a5f

	/// Portfolio return on investment as a multiple: total profit divided by total budget, over movies where both are known. 2.0x means each dollar of budget returned two dollars of profit. For a single movie it is that movie's own ROI.
	measure ROI = DIVIDE(SUM(Movies[Profit]), CALCULATE(SUM(Movies[Budget]), Movies[Has Financials] = "Yes"))
		formatString: 0.0"x"
		displayFolder: Financials
		lineageTag: 3bc082a7-4463-465c-94c7-bead9fcddabf

	/// Median per-movie ROI as a multiple of budget (profit divided by budget); robust to a few extreme hits. Only movies with known budget and revenue.
	measure 'Median ROI' = MEDIAN(Movies[Movie ROI])
		formatString: 0.0"x"
		displayFolder: Financials
		lineageTag: d0d2f3bf-9614-4d3d-8e04-03c59854ec28

	/// Share of movies with known budget and revenue whose revenue exceeded budget.
	measure 'Hit Rate' = DIVIDE(CALCULATE(COUNTROWS(Movies), Movies[Has Financials] = "Yes", Movies[Profit] > 0), [Movies with Financials])
		formatString: 0%
		displayFolder: Financials
		lineageTag: 6305d1ac-180a-4bb2-88bc-47d9f106fe7f

	/// Average runtime in minutes across movies with a recorded runtime.
	measure 'Avg Runtime' = AVERAGE(Movies[Runtime])
		formatString: 0 "min"
		displayFolder: Runtime
		lineageTag: 26d25802-de95-4a8d-8c45-507c1e168209

	/// Average runtime minus the average runtime of every movie in the model.
	measure 'Runtime vs All Films' = [Avg Runtime] - CALCULATE(AVERAGE(Movies[Runtime]), REMOVEFILTERS(Movies), REMOVEFILTERS(Genres), REMOVEFILTERS(MovieGenres))
		formatString: +0 "min";-0 "min";0 "min"
		displayFolder: Runtime
		lineageTag: 2909ad8e-8a5e-4e06-8692-235eca8d1984

	/// Genre with the most movies in the current selection.
	measure 'Top Genre' = MAXX(TOPN(1, VALUES(Genres[Genre]), [Movies], DESC), Genres[Genre])
		displayFolder: Labels and Visuals
		lineageTag: 789dfd40-b794-4a45-8259-7de6767cbc2c

	/// Decade with the highest Weighted Rating among decades with at least 100 movies in the selection.
	measure 'Best Rated Decade' = MAXX(TOPN(1, FILTER(VALUES(Movies[Decade]), [Movies] >= 100), [Weighted Rating], DESC), Movies[Decade])
		displayFolder: Labels and Visuals
		lineageTag: 582e01a0-0b83-4f5a-95cf-bbebd7170040

	/// Dynamic one-line subtitle describing the current selection.
	measure 'Selection Summary' = FORMAT([Movies], "#,##0") & " films  |  " & FORMAT([Weighted Rating], "0.0") & " rating  |  $" & FORMAT(DIVIDE([Total Revenue], 1000000000), "#,0.0") & "B revenue"
		displayFolder: Labels and Visuals
		lineageTag: 452409a5-37d5-4221-b82e-113ff3547c3b

	/// Total budget in millions of US dollars; used for scatter axes so labels stay readable.
	measure 'Budget (USD M)' = DIVIDE([Total Budget], 1000000)
		formatString: $#,0.##"M"
		displayFolder: Financials
		lineageTag: d6500f02-bc1f-4560-a31d-6e249056b168

	/// Total revenue in millions of US dollars; used for scatter axes so labels stay readable.
	measure 'Revenue (USD M)' = DIVIDE([Total Revenue], 1000000)
		formatString: $#,0.##"M"
		displayFolder: Financials
		lineageTag: 5bec2014-b919-4f07-97c5-b36def065893

	/// KPI card: film count, output growth vs the 1980s, peak year and share of the catalogue.
	measure 'KPI Films HTML' = ```
			
						VAR _g = COALESCE([Output Growth vs 1980s], 0)
						VAR __value = FORMAT(COALESCE([Movies], 0), "#,##0", "en-US")
						VAR __hi = IF(_g - 1 >= 0, "&#9650; ", "&#9660; ") & FORMAT(_g, "0.0", "en-US") & "x"
						VAR __hicol = IF(_g - 1 >= 0, "#34D399", "#FB923C")
						VAR __text = "films per year vs 1980s"
						VAR __f0 = COALESCE(FORMAT([Peak Year], "0", "en-US"), "-") & " (" & FORMAT(COALESCE([Peak Year Films], 0), "#,##0", "en-US") & ")"
						VAR __f1 = FORMAT(COALESCE([Share of All Films], 0), "0%", "en-US")
						RETURN
						"<div style='box-sizing:border-box;height:100vh;width:100%;padding:26px 18px 16px 26px;border-radius:12px;background:linear-gradient(150deg,rgba(34,211,238,.13) 0%,rgba(11,23,48,0) 55%);font-family:Segoe UI,sans-serif;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start'>" &
						"<div style='position:absolute;left:0;top:18%;height:64%;width:4px;border-radius:0 4px 4px 0;background:#22D3EE;box-shadow:0 0 12px #22D3EE'></div>" &
						"<div style='font-size:12px;letter-spacing:2px;color:#9DB4D8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>FILMS IN SELECTION</div>" &
						"<div style='margin-top:4px;font-size:48px;line-height:1.08;font-weight:700;color:#EAF2FF;font-family:Bahnschrift,Segoe UI,sans-serif;text-shadow:0 0 16px rgba(34,211,238,.45);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & __value & "</div>" &
						"<div style='margin-top:8px;font-size:15px;line-height:1.35;color:#C9D7EE;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'><span style='color:" & __hicol & ";font-weight:700'>" & __hi & "</span> " & __text & "</div>" &
						"<div style='margin-top:12px;padding-top:10px;border-top:1px solid rgba(157,180,216,.16);display:flex;flex-wrap:wrap;column-gap:18px;row-gap:2px;font-size:13px'>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>Peak year</span> <span style='color:#EAF2FF;font-weight:600'>" & __f0 & "</span></span>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>Catalogue</span> <span style='color:#EAF2FF;font-weight:600'>" & __f1 & "</span></span>" &
						"</div>" &
						"</div>"
			```
		displayFolder: KPI HTML
		lineageTag: aed8d2a9-4c21-488b-9cbe-92dafa13e3d3

	/// KPI card: weighted rating, change from the 1980s to the 2010s, share rated 7+ and difference vs all films.
	measure 'KPI Rating HTML' = ```
			
						VAR _c = COALESCE([Rating Change vs 1980s], 0)
						VAR __value = FORMAT(COALESCE([Weighted Rating], 0), "0.00", "en-US") & "<span style='font-size:22px;color:#9DB4D8'> / 10</span>"
						VAR __hi = IF(_c >= 0, "&#9650; ", "&#9660; ") & FORMAT(ABS(_c), "0.00", "en-US")
						VAR __hicol = IF(_c >= 0, "#34D399", "#FB923C")
						VAR __text = "in the 2010s vs the 1980s"
						VAR __f0 = FORMAT(COALESCE([% Rated 7+], 0), "0%", "en-US")
						VAR __f1 = IF(COALESCE([Rating vs All Films], 0) >= 0, "+", "") & FORMAT(COALESCE([Rating vs All Films], 0), "0.00", "en-US")
						RETURN
						"<div style='box-sizing:border-box;height:100vh;width:100%;padding:26px 18px 16px 26px;border-radius:12px;background:linear-gradient(150deg,rgba(167,139,250,.13) 0%,rgba(11,23,48,0) 55%);font-family:Segoe UI,sans-serif;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start'>" &
						"<div style='position:absolute;left:0;top:18%;height:64%;width:4px;border-radius:0 4px 4px 0;background:#A78BFA;box-shadow:0 0 12px #A78BFA'></div>" &
						"<div style='font-size:12px;letter-spacing:2px;color:#9DB4D8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>WEIGHTED RATING</div>" &
						"<div style='margin-top:4px;font-size:48px;line-height:1.08;font-weight:700;color:#EAF2FF;font-family:Bahnschrift,Segoe UI,sans-serif;text-shadow:0 0 16px rgba(167,139,250,.45);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & __value & "</div>" &
						"<div style='margin-top:8px;font-size:15px;line-height:1.35;color:#C9D7EE;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'><span style='color:" & __hicol & ";font-weight:700'>" & __hi & "</span> " & __text & "</div>" &
						"<div style='margin-top:12px;padding-top:10px;border-top:1px solid rgba(157,180,216,.16);display:flex;flex-wrap:wrap;column-gap:18px;row-gap:2px;font-size:13px'>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>Rated 7+</span> <span style='color:#EAF2FF;font-weight:600'>" & __f0 & "</span></span>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>vs all films</span> <span style='color:#EAF2FF;font-weight:600'>" & __f1 & "</span></span>" &
						"</div>" &
						"</div>"
			```
		displayFolder: KPI HTML
		lineageTag: a880f40f-c3e8-4b7b-9d52-54fb084c56e8

	/// KPI card: total revenue, share earned by franchise films, profit margin and top-10 concentration.
	measure 'KPI Revenue HTML' = ```
			
						VAR __value = (VAR __m = COALESCE([Total Revenue], 0) RETURN IF(__m >= 1000000000, "$" & FORMAT(__m / 1000000000, "#,##0.0", "en-US") & "bn", IF(__m >= 1000000, "$" & FORMAT(__m / 1000000, "#,##0.0", "en-US") & "M", "$" & FORMAT(__m / 1000, "#,##0", "en-US") & "K")))
						VAR __hi = FORMAT(COALESCE([Franchise Revenue Share], 0), "0%", "en-US")
						VAR __hicol = "#3B82F6"
						VAR __text = "earned by franchise films"
						VAR __f0 = FORMAT(COALESCE([Profit Margin], 0), "0%", "en-US")
						VAR __f1 = FORMAT(COALESCE([Top 10 Revenue Share], 0), "0.0%", "en-US")
						RETURN
						"<div style='box-sizing:border-box;height:100vh;width:100%;padding:26px 18px 16px 26px;border-radius:12px;background:linear-gradient(150deg,rgba(59,130,246,.13) 0%,rgba(11,23,48,0) 55%);font-family:Segoe UI,sans-serif;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start'>" &
						"<div style='position:absolute;left:0;top:18%;height:64%;width:4px;border-radius:0 4px 4px 0;background:#3B82F6;box-shadow:0 0 12px #3B82F6'></div>" &
						"<div style='font-size:12px;letter-spacing:2px;color:#9DB4D8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>TOTAL REVENUE</div>" &
						"<div style='margin-top:4px;font-size:48px;line-height:1.08;font-weight:700;color:#EAF2FF;font-family:Bahnschrift,Segoe UI,sans-serif;text-shadow:0 0 16px rgba(59,130,246,.45);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & __value & "</div>" &
						"<div style='margin-top:8px;font-size:15px;line-height:1.35;color:#C9D7EE;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'><span style='color:" & __hicol & ";font-weight:700'>" & __hi & "</span> " & __text & "</div>" &
						"<div style='margin-top:12px;padding-top:10px;border-top:1px solid rgba(157,180,216,.16);display:flex;flex-wrap:wrap;column-gap:18px;row-gap:2px;font-size:13px'>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>Margin</span> <span style='color:#EAF2FF;font-weight:600'>" & __f0 & "</span></span>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>Top 10 films</span> <span style='color:#EAF2FF;font-weight:600'>" & __f1 & "</span></span>" &
						"</div>" &
						"</div>"
			```
		displayFolder: KPI HTML
		lineageTag: 4a6b7147-4d9e-43ed-b2ef-3f5a316b9e10

	/// KPI card: total budget, budget as a share of revenue, median budget and number of $100M+ productions.
	measure 'KPI Budget HTML' = ```
			
						VAR _ratio = COALESCE(DIVIDE(CALCULATE(SUM(Movies[Budget]), Movies[Has Financials] = "Yes"), CALCULATE(SUM(Movies[Revenue]), Movies[Has Financials] = "Yes")), 0)
						VAR __value = (VAR __m = COALESCE([Total Budget], 0) RETURN IF(__m >= 1000000000, "$" & FORMAT(__m / 1000000000, "#,##0.0", "en-US") & "bn", IF(__m >= 1000000, "$" & FORMAT(__m / 1000000, "#,##0.0", "en-US") & "M", "$" & FORMAT(__m / 1000, "#,##0", "en-US") & "K")))
						VAR __hi = FORMAT(_ratio, "0%", "en-US")
						VAR __hicol = "#60A5FA"
						VAR __text = "of revenue went into budgets"
						VAR __f0 = (VAR __m = COALESCE([Median Budget], 0) RETURN IF(__m >= 1000000000, "$" & FORMAT(__m / 1000000000, "#,##0.0", "en-US") & "bn", IF(__m >= 1000000, "$" & FORMAT(__m / 1000000, "#,##0.0", "en-US") & "M", "$" & FORMAT(__m / 1000, "#,##0", "en-US") & "K")))
						VAR __f1 = FORMAT(COALESCE([Big Budget Films], 0), "#,##0", "en-US")
						RETURN
						"<div style='box-sizing:border-box;height:100vh;width:100%;padding:26px 18px 16px 26px;border-radius:12px;background:linear-gradient(150deg,rgba(96,165,250,.13) 0%,rgba(11,23,48,0) 55%);font-family:Segoe UI,sans-serif;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start'>" &
						"<div style='position:absolute;left:0;top:18%;height:64%;width:4px;border-radius:0 4px 4px 0;background:#60A5FA;box-shadow:0 0 12px #60A5FA'></div>" &
						"<div style='font-size:12px;letter-spacing:2px;color:#9DB4D8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>TOTAL BUDGET</div>" &
						"<div style='margin-top:4px;font-size:48px;line-height:1.08;font-weight:700;color:#EAF2FF;font-family:Bahnschrift,Segoe UI,sans-serif;text-shadow:0 0 16px rgba(96,165,250,.45);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & __value & "</div>" &
						"<div style='margin-top:8px;font-size:15px;line-height:1.35;color:#C9D7EE;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'><span style='color:" & __hicol & ";font-weight:700'>" & __hi & "</span> " & __text & "</div>" &
						"<div style='margin-top:12px;padding-top:10px;border-top:1px solid rgba(157,180,216,.16);display:flex;flex-wrap:wrap;column-gap:18px;row-gap:2px;font-size:13px'>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>Median</span> <span style='color:#EAF2FF;font-weight:600'>" & __f0 & "</span></span>" &
							"<span style='white-space:nowrap'><span style='color:#7F97BD'>$100M+ budgets</span> <span style='color:#EAF2FF;font-weight:600'>" & __f1 & "</span></span>" &
						"</div>" &
						"</div>"
			```
		displayFolder: KPI HTML
		lineageTag: c24c1190-bd67-4d05-b4aa-213185cd6254

	/// KPI card: average runtime, share of films over two hours, median runtime and difference vs all films.
	measure 'KPI Runtime HTML' = ```
			
						VAR __value = FORMAT(COALESCE([Avg Runtime], 0), "0", "en-US") & "<span style='font-size:22px;color:#9DB4D8'> min</span>"
						VAR __hi = FORMAT(COALESCE([% Over 2 Hours], 0), "0%", "en-US")
						VAR __hicol = "#2DD4BF"
						VAR __text = "of films run over 2 hours"
						VAR __f0 = FORMAT(COALESCE([Median Runtime], 0), "0", "en-US") & " min"
						VAR __f1 = IF(COALESCE([Runtime vs All Films], 0) >= 0, "+", "") & FORMAT(COALESCE([Runtime vs All Films], 0), "0", "en-US") & " min"
						RETURN
						"<div style='box-sizing:border-box;height:100vh;width:100%;padding:26px 18px 16px 26px;border-radius:12px;background:linear-gradient(150deg,rgba(45,212,191,.13) 0%,rgba(11,23,48,0) 55%);font-family:Segoe UI,sans-serif;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start'>" &
						"<div style='position:absolute;left:0;top:18%;height:64%;width:4px;border-radius:0 4px 4px 0;background:#2DD4BF;box-shadow:0 0 12px #2DD4BF'></div>" &
						"<div style='font-size:12px;letter-spacing:2px;color:#9DB4D8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>AVERAGE RUNTIME</div>" &
						"<div style='margin-top:4px;font-size:48px;line-height:1.08;font-weight:700;color:#EAF2FF;font-family:Bahnschrift,Segoe UI,sans-serif;text-shadow:0 0 16px rgba(45,212,191,.45);white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & __value & "</div>" &
						"<div style='margin-top:8px;font-size:15px;line-height:1.35;color:#C9D7EE;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'><span style='color:" & __hicol & ";font-weight:700'>" & __hi & "</span> " & __text & "</div>" &
						"<div style='margin-top:12px;padding-top:10px;border-top:1px solid rgba(157,180,216,.16);display:flex;flex-wrap:wrap;column-gap:18px;row-gap:2px;font-size:13px'>" &
